<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ishovkun.sync-hub-models</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ishovkun/dotfiles/misc/sync-hub-models-cron</string>
  </array>
  <!-- Thursday 18:00 local time (Pacific). Missed runs fire on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>4</integer>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ishovkun/.local/state/sync-hub-models/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/ishovkun/.local/state/sync-hub-models/launchd.err</string>
</dict>
</plist>
