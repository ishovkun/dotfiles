  "search": {
    // Include gitignored files in project search (Cmd-Shift-F).
    // gitignore controls git tracking, not searchability.
    "include_ignored": true
  },
  "file_finder": {
    // Include gitignored files in the file finder (Cmd-P / space space).
    // "all" = every gitignored file, "indexed" = only ones Zed has indexed,
    // "smart" = only when opened from a gitignored worktree (default).
    "include_ignored": "all"
  },
  // Scan these globs even when gitignored, marking them "always included" so they
  // show everywhere — project panel, search, AND the agent @-mention picker (which
  // has no include-ignored setting of its own). Replaces Zed's default [".env*"].
  "file_scan_inclusions": [".env*", ".plans/**"],
