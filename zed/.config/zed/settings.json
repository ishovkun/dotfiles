// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "Catppuccin Frappé",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent",
        "reasoning_effort": "xhigh"
      },
      "type": "custom",
      "command": "/home/ishovkun/.local/bin/zed-acp-approver",
      "args": ["--agent","codex","--sock","/home/ishovkun/.claude/approver.sock","--","/home/ishovkun/.local/bin/codex-acp"]
    },
    "claude-acp": {
      "default_config_options": {
        "fast": "off",
        "mode": "auto",
        "model": "opus[1m]",
        "effort": "xhigh"
      },
      "type": "custom",
      "command": "/home/ishovkun/.local/bin/zed-acp-approver",
      "args": ["--agent","claude","--sock","/home/ishovkun/.claude/approver.sock","--","/home/ishovkun/.local/bin/claude-agent-acp"]
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
